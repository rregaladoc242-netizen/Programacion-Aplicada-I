<Window x:Class="EjemploSQLCommandInsertar.AgregarCategoria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Producto y Categoría" Height="450" Width="600">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nombre del Producto -->
        <Label Grid.Row="0" Grid.Column="0" Content="Producto:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtNombreProducto" Grid.Row="0" Grid.Column="1" Height="25" Margin="5"/>

        <!-- Precio -->
        <Label Grid.Row="1" Grid.Column="0" Content="Precio:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtPrecio" Grid.Row="1" Grid.Column="1" Height="25" Margin="5"/>

        <!-- Categoría (Nuevo) -->
        <Label Grid.Row="2" Grid.Column="0" Content="Categoría:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtCategoria" Grid.Row="2" Grid.Column="1" Height="25" Margin="5"/>

        <!-- Botón Guardar -->
        <Button x:Name="btnGuardar" Grid.Row="3" Grid.Column="1" Content="Guardar" Width="100" Height="30" HorizontalAlignment="Left" Margin="5,10,5,10" Click="BtnGuardar_Click"/>

        <!-- DataGrid para mostrar el resultado -->
        <DataGrid x:Name="dgResultado" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" AutoGenerateColumns="True" IsReadOnly="True" Margin="5"/>
    </Grid>
</Window>